{
  "name": "task-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-scoped task relay CLI for routing source work items to isolated coding-agent workspaces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "relay": "./bin/relay.js",
    "relay-dev": "./bin/relay-dev.js",
    "task-relay": "./bin/relay.js"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-declarations.mjs && npm run dashboard:build",
    "prepare": "npm run build",
    "test": "vitest run",
    "start": "tsx src/cli/main.ts",
    "dev:cli": "node bin/relay-dev.js",
    "dashboard:dev": "vite --config src/dashboard/client/vite.config.ts",
    "dashboard:build": "vite build --config src/dashboard/client/vite.config.ts",
    "dashboard:check": "tsc --noEmit -p tsconfig.dashboard.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@actions/expressions": "^0.3.61",
    "@inquirer/prompts": "^7.5.0",
    "@mantine/core": "^9.6.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xyflow/react": "^12.11.5",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "cosmiconfig": "^9.0.0",
    "execa": "^9.5.2",
    "handlebars": "^4.7.8",
    "p-queue": "^8.1.0",
    "p-retry": "^6.2.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.3",
    "write-file-atomic": "^6.0.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
